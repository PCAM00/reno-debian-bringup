# OPPO Reno PCAM00 memory-only UEFI prototype (compile-only).
# Merge on top of qcom_defconfig, then run olddefconfig and assert the result
# with scripts/validate_config.py.  Every line here exists in the pinned tree.
CONFIG_TARGET_QCOM=y
CONFIG_ARCH_SNAPDRAGON=y
CONFIG_DEFAULT_DEVICE_TREE="qcom/sdm710-oppo-pcam00-uefi-memonly"
# CONFIG_OF_UPSTREAM_BUILD_VENDOR is not set

# --- UEFI application execution, no boot manager, no media behind it ---
CONFIG_EFI_LOADER=y
CONFIG_EFI_BINARY_EXEC=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BINARY=y
CONFIG_EFI_MEDIA=y
# CONFIG_EFI_MEDIA_BLK is not set
# CONFIG_EFI_BOOTMGR is not set
# CONFIG_CMD_BOOTEFI_BOOTMGR is not set
CONFIG_BOOTEFI_HELLO_COMPILE=y
# CONFIG_CMD_BOOTEFI_HELLO is not set

# --- UEFI variables live only in RAM ---
CONFIG_EFI_VARIABLE_NO_STORE=y
# CONFIG_EFI_VARIABLE_FILE_STORE is not set
# CONFIG_EFI_VARIABLE_SF_STORE is not set
# CONFIG_CMD_NVEDIT_EFI is not set
# CONFIG_EFI_RUNTIME_UPDATE_CAPSULE is not set
# CONFIG_EFI_CAPSULE_ON_DISK is not set

# --- environment: compiled in, never persisted ---
CONFIG_ENV_IS_NOWHERE=y
CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/oppo/pcam00/pcam00-uefi-memonly.env"
# CONFIG_CMD_SAVEENV is not set

# --- no boot flow, no network, no scripting shortcuts ---
# CONFIG_BOOTSTD is not set
# CONFIG_BOOTSTD_FULL is not set
# CONFIG_USE_PREBOOT is not set

# --- no physical block storage of any kind ---
# CONFIG_SCSI is not set
# CONFIG_UFS is not set
# CONFIG_UFS_QCOM is not set
# CONFIG_MMC is not set
# CONFIG_MMC_WRITE is not set
# CONFIG_NVME is not set
# CONFIG_MTD is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_FAT_WRITE is not set
# CONFIG_EXT4_WRITE is not set
# CONFIG_CMD_GPT is not set

# --- no partition table parsers: there is no medium to parse ---
# CONFIG_PARTITIONS is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_DOS_PARTITION is not set

# --- no flashing or firmware-update surfaces ---
# CONFIG_FASTBOOT is not set
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_CMD_DFU is not set
# CONFIG_DFU_MMC is not set
# CONFIG_DFU_SCSI is not set
# CONFIG_CMD_BCB is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set

# --- no raw memory/IO/PMIC poking from the console ---
# CONFIG_CMD_MEMORY is not set
# CONFIG_CMD_IO is not set
# CONFIG_CMD_GPIO is not set
# CONFIG_CMD_I2C is not set
# CONFIG_CMD_EEPROM is not set
# CONFIG_CMD_REGULATOR is not set

# --- console-less baseline ---
CONFIG_SYS_DEVICE_NULLDEV=y
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
CONFIG_BOOTDELAY=-1
